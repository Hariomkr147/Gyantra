# ─────────────────────────────────────────────────────────────────────────
# Gyantra configuration
#
#   cp .env.example backend/.env
#
# Note the destination: settings load relative to the process working
# directory, and the backend runs from backend/.
#
# To try the app with no API key at all, set DEMO_MODE=true.
# ─────────────────────────────────────────────────────────────────────────

# ── LLM providers ────────────────────────────────────────────────────────
# Comma-separated preference order. The first configured provider is tried
# first; on a permanent failure (dead model, bad key) the client fails over
# to the next one immediately rather than retrying.
#
# Gemini leads by default: Google AI Studio's free tier is the most reliable
# of the three and its model IDs are stable. OpenRouter rotates free models
# in and out without notice, which is exactly what used to strand the
LLM_PROVIDER=routesme,gemini,groq,openrouter

# Gemini — https://aistudio.google.com/apikey  (free tier, recommended)
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys  (free tier, very fast)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional generic OpenAI-compatible gateway (e.g. routesme.online).
# Dormant unless a key is set; add "routesme" to LLM_PROVIDER to use it.
ROUTESME_API_KEY=
ROUTESME_BASE_URL=https://routesme.online/v1
ROUTESME_MODEL_FAST=GLM5.2R
ROUTESME_MODEL_EXTRACT=GLM5.2R
ROUTESME_MODEL_PLAN=GLM5.2R
ROUTESME_MODEL_GENERATE=GLM5.2R
ROUTESME_MODEL_VALIDATE=GLM5.2R

# Nvidia NIM integration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_EXTRACT=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_PLAN=deepseek-ai/deepseek-r1
NVIDIA_MODEL_GENERATE=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_VALIDATE=meta/llama-3.1-8b-instruct

# ── Demo mode ────────────────────────────────────────────────────────────
# true  = run the pipeline against a deterministic offline stub. No API key
#         needed, all 10 stages execute, output is structurally valid but
#         pedagogically shallow. Every package is tagged demo_mode=true.
# false = real model output.
DEMO_MODE=false

# ── Per-role model IDs ───────────────────────────────────────────────────
# Roles map to stages: fast=classification, extract=knowledge + gap analysis,
# plan=teaching planner, generate=content/activities/assessments,
# validate=grounding audit.
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_EXTRACT=gemini-2.0-flash
GEMINI_MODEL_PLAN=gemini-2.0-flash
GEMINI_MODEL_GENERATE=gemini-2.0-flash
GEMINI_MODEL_VALIDATE=gemini-2.0-flash-lite

GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_EXTRACT=llama-3.3-70b-versatile
GROQ_MODEL_PLAN=llama-3.3-70b-versatile
GROQ_MODEL_GENERATE=llama-3.3-70b-versatile
GROQ_MODEL_VALIDATE=llama-3.1-8b-instant

# Instruction-tuned models, deliberately not reasoning models: reasoning
# models emit chain-of-thought before the JSON, burning output tokens and
# often truncating the answer itself.
OPENROUTER_MODEL_FAST=google/gemma-4-31b-it:free
OPENROUTER_MODEL_EXTRACT=google/gemma-4-31b-it:free
OPENROUTER_MODEL_PLAN=google/gemma-4-31b-it:free
OPENROUTER_MODEL_GENERATE=google/gemma-4-31b-it:free
OPENROUTER_MODEL_VALIDATE=openai/gpt-oss-20b:free

# ── LLM behaviour ────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Caches responses on disk keyed by (provider, model, prompt). Makes re-runs
# free during development.
LLM_CACHE_ENABLED=true
# Probe every provider at startup so a dead model ID or revoked key shows up
# in the log immediately instead of stalling the first upload.
LLM_PROBE_ON_STARTUP=true
# When a 429 states a retry delay longer than this many seconds, fail over to
# the next provider instead of waiting. Free tiers routinely quote minutes.
RATE_LIMIT_WAIT_CEILING=20

# ── Document parsing ─────────────────────────────────────────────────────
# Docling is the primary parser for PDF/DOCX/PPTX — real reading order, table
# structure and heading hierarchy instead of font-size heuristics. The
# built-in parsers remain the automatic fallback.
DOCLING_ENABLED=true
# Download docling's models at boot. Costs a slow first startup; avoids a
# multi-minute stall inside a teacher's first upload.
DOCLING_WARMUP_ON_STARTUP=true
DOCLING_THREADS=2
# Docling's layout models need roughly this much free RAM. Below it, Gyantra
# skips docling and uses the built-in parser rather than dying mid-parse.
DOCLING_MIN_MEMORY_MB=1500

# OCR needs tesseract on PATH. The Docker image includes it.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MAX_PAGES=40
SCANNED_TEXT_THRESHOLD=120

# ── Token budget ─────────────────────────────────────────────────────────
# Tuned for small free-tier context windows.
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
MIN_CHUNK_TOKENS=60
MAX_CHUNKS=40
MAX_CONTEXT_TOKENS_PER_CALL=6000
MAX_SOURCE_SNIPPETS_PER_STAGE=8

# ── Storage ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/gyantra.db
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
CACHE_DIR=./data/cache
MAX_FILE_SIZE_MB=25

# ── Pipeline ─────────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=900
# Concurrent LLM calls in the fan-out stages. Keep low on free tiers.
PARALLEL_PERIOD_GENERATION=2
MIN_PERIODS=1
MAX_PERIODS=12

SUPPORTED_LANGUAGES=english,hindi,bengali,tamil,telugu,marathi

# ── API ──────────────────────────────────────────────────────────────────
DEBUG=false
# Comma-separated list of allowed origins. For production, add your frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
